VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Use enterprise for a reCAPTCHA Enterprise registration; v3 preserves existing setups.
VITE_FIREBASE_APPCHECK_PROVIDER=v3
# Development only; ignored by production builds.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_APPCHECK_DEBUG=false

# Only exposes empty-account enablement; server WORKSPACE_V2_ENABLED must also be enabled.
VITE_WORKSPACE_V2_ENABLED=false
