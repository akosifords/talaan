{
  "name": "talaan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test test/validators.test.js test/planning.test.js test/workspaceRoutes.test.js test/backend-contracts.test.js && npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:emulators": "firebase emulators:exec --project demo-talaan --only auth,firestore,functions \"node --test test/emulators.test.js\"",
    "emulators": "firebase emulators:start",
    "functions:install": "npm --prefix functions install",
    "functions:deploy": "firebase deploy --only functions,firestore",
    "test:backend": "firebase emulators:exec --project demo-talaan --only firestore \"node --test test/backend-migration.test.js test/firestore.rules.test.js\"",
    "check:staging": "node scripts/staging-preflight.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "firebase-tools": "^15.30.0",
    "globals": "^16.5.0",
    "vite": "^7.0.0"
  }
}
